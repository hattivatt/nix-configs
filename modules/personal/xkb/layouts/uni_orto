    key <AD08> { [ Cyrillic_sha, Cyrillic_SHA, Cyrillic_shcha, Cyrillic_SHCHA ] };
    key <AD09> { [ Cyrillic_ze, Cyrillic_ZE  ] };
    key <AD10> { [ Cyrillic_ha, Cyrillic_HA  ] };
    key <AC11> { [ period, colon, greater, greaterthanequal ] };
