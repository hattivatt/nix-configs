// English Universal
xkb_symbols "unieng" {

    include "uni_orto(basic)"
    name[Group1]= "English Universal";

    key <TLDE> { [ apostrophe, quotedbl, grave, U0301 ] };
    key <AE01> { [ 1, exclam, onesuperior, exclamdown ] };
    key <AE02> { [ 2, at, twosuperior, onehalf ] };
    key <AE03> { [ 3, numbersign, threesuperior, onethird ] };
    key <AE04> { [ 4, dollar ] };
    key <AE05> { [ 5, percent, permille ] };
    key <AE06> { [ 6, asciicircum, U0302 ] };
    key <AE07> { [ 7, question, questiondown ] };
    key <AE08> { [ 8, asterisk, infinity, doublelowquotemark ] };
    key <AE09> { [ 9, parenleft, leftdoublequotemark, leftsinglequotemark ] };
    key <AE10> { [ 0, parenright, rightdoublequotemark, rightsinglequotemark ] };
    key <AE11> { [ minus, underscore, endash, emdash ] };
    key <AE12> { [ equal, plus, notequal, plusminus ] };

    key <BKSL> { [ slash, bar, backslash] };

    key <AD03> { [ e, E, EuroSign ] };
    key <AD07> { [ u, U, udiaeresis, Udiaeresis ] };
    key <AD08> { [ i, I, idotless, Iabovedot ] };
    key <AD09> { [ o, O, odiaeresis, Odiaeresis ] };
    key <AD11> { [ bracketleft,	braceleft, bracketleft, braceleft ] };
    key <AD12> { [ comma, semicolon, less, lessthanequal ] };

    key <AC01> { [ a, A, adiaeresis, Adiaeresis ] };
    key <AC02> { [ s, S, scedilla, Scedilla ] };
    key <AC05> { [ g, G, gbreve, Gbreve ] };
    key <AC06> { [ h, H, U20BD ] };
    key <AC10> { [ asciitilde, asciitilde, guillemotright, rightarrow ] };
    key <AC11> { [ period, colon, greater, greaterthanequal ] };

    key <AB02> { [ x, X, multiply ] };
    key <AB03> { [ c, C, ccedilla, Ccedilla ] };
    key <AB06> { [ n, N, U2116 ] };
    key <AB08> { [ ampersand, ampersand, ampersand,  ellipsis ] };
    key <AB09> { [ bracketleft,	braceleft, bracketleft, braceleft ] };
    key <AB10> { [ bracketright, braceright, bracketright, braceright ] };

    include "level3(ralt_switch)"
};

// Russian Universal
xkb_symbols "unirus" {

    include "uni_orto(common)"
    name[Group1]= "Russian Universal";

    key <TLDE> { [ apostrophe, quotedbl, grave, U0301 ] };
    key <AE01> { [ 1, exclam, onesuperior, exclamdown ] };
