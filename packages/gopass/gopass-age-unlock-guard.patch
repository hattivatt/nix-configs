diff -urN a/internal/backend/crypto/age/unlocklock_unix.go b/internal/backend/crypto/age/unlocklock_unix.go
--- a/internal/backend/crypto/age/unlocklock_unix.go	1970-01-01 08:00:00.000000000 +0800
+++ b/internal/backend/crypto/age/unlocklock_unix.go	2026-11-15 12:44:11.015484944 +0700
@@ -0,0 +1,83 @@
+//go:build !windows
+
+package age
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/gopasspw/gopass/pkg/appdir"
+)
+
+const unlockLockName = "age-unlock.lock"
+
+type unlockLock struct {
+	file *os.File
+}
+
+func acquireUnlockLock() (*unlockLock, error) {
+	dir := appdir.UserRuntime()
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return nil, fmt.Errorf("failed to create runtime directory: %w", err)
+	}
+
+	file, err := os.OpenFile(filepath.Join(dir, unlockLockName), os.O_RDWR|os.O_CREATE, 0o600)
+	if err != nil {
+		return nil, fmt.Errorf("failed to open unlock lock: %w", err)
+	}
+
+	for {
+		err = syscall.Flock(int(file.Fd()), syscall.LOCK_EX)
+		if !errors.Is(err, syscall.EINTR) {
+			break
+		}
+	}
+	if err != nil {
+		_ = file.Close()
+
+		return nil, fmt.Errorf("failed to acquire unlock lock: %w", err)
+	}
+
+	return &unlockLock{file: file}, nil
+}
+
+func (l *unlockLock) failedAfter(t time.Time) bool {
+	if l == nil {
+		return false
+	}
+
+	buf := make([]byte, 32)
+	n, _ := l.file.ReadAt(buf, 0)
+	nanos, err := strconv.ParseInt(strings.TrimSpace(string(buf[:n])), 10, 64)
+	if err != nil {
+		return false
+	}
+
+	return time.Unix(0, nanos).After(t)
+}
+
+func (l *unlockLock) markFailed() {
+	if l == nil {
+		return
+	}
+
+	if err := l.file.Truncate(0); err != nil {
+		return
+	}
+	_, _ = l.file.WriteAt([]byte(strconv.FormatInt(time.Now().UnixNano(), 10)), 0)
+}
+
+func (l *unlockLock) release() {
+	if l == nil {
+		return
+	}
+
+	_ = syscall.Flock(int(l.file.Fd()), syscall.LOCK_UN)
+	_ = l.file.Close()
+}
