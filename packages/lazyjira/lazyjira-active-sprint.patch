+// tabNeedsActiveSprint reports whether the active tab's JQL uses the
+// {{.ActiveSprint}} template variable.
+func (a *App) tabNeedsActiveSprint() bool {
+	tab := a.issuesList.ActiveTab()
+	return strings.Contains(tab.JQL, "ActiveSprint")
+}
+
+// activeSprint returns the cached active sprint id for the current project.
+func (a *App) activeSprint() int {
+	if a.activeSprints == nil {
+		return 0
+	}
+	return a.activeSprints[a.projectKey]
+}
+
+// handleActiveSprintLoaded caches the resolved active sprint id and refreshes
+// the tab when it fetched before the id was known.
+func (a *App) handleActiveSprintLoaded(msg activeSprintLoadedMsg) (tea.Model, tea.Cmd) {
+	if a.activeSprints == nil {
+		a.activeSprints = make(map[string]int)
+	}
+	a.activeSprints[msg.projectKey] = msg.sprintID
+	if msg.projectKey == a.projectKey && a.tabNeedsActiveSprint() {
+		return a, a.fetchActiveTab()
+	}
+	return a, nil
+}
