+// activeSprintLoadedMsg carries the resolved active sprint id for a project.
+type activeSprintLoadedMsg struct {
+	projectKey string
+	sprintID   int
+}
+
+// fetchActiveSprint resolves the active sprint of a board for the
+// {{.ActiveSprint}} template variable. A zero id means no active sprint.
+func fetchActiveSprint(client jira.ClientInterface, boardID int, projectKey string) tea.Cmd {
+	return func() tea.Msg {
+		if boardID == 0 {
+			return activeSprintLoadedMsg{projectKey: projectKey}
+		}
+		sprints, err := client.GetSprints(context.Background(), boardID)
+		if err != nil {
+			return activeSprintLoadedMsg{projectKey: projectKey}
+		}
+		for _, s := range sprints {
+			if s.State == "active" {
+				return activeSprintLoadedMsg{projectKey: projectKey, sprintID: s.ID}
+			}
+		}
+		return activeSprintLoadedMsg{projectKey: projectKey}
+	}
+}
